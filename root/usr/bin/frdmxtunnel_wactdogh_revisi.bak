#!/bin/sh
# Beri jeda 15 detik di awal agar core & handshake selesai
sleep 15

FAIL_COUNT=0
CHECK_URL="http://bing.com"

while true; do
    # Cek setiap 25 detik agar tidak membebani CPU/jaringan saat sibuk
    sleep 25

    [ -f "/tmp/frdmxtunnel_ctrl.lock" ] && continue
    ENABLED=$(uci -q get frdmxtunnel.main.enabled)
    [ "$ENABLED" != "1" ] && continue

    # Cek protokol profil aktif saat ini (0-based index di UCI)
    CURR_IDX=$(cat /tmp/frdmxtunnel_active_idx 2>/dev/null || echo 1)
    UCI_IDX=$((CURR_IDX - 1))
    PROTO_NOW=$(uci -q get frdmxtunnel.@profile[$UCI_IDX].proto)

    # Pastikan proses core sesuai protokol masih berjalan
    if [ "$PROTO_NOW" = "ovpn" ]; then
        if ! pidof openvpn >/dev/null 2>&1; then
            echo "$(date '+%Y-%m-%d %H:%M:%S') - [Watchdog] OpenVPN mati, menjalankan ulang..." >> /tmp/frdmxtunnel.log
            /usr/bin/frdmxtunnel_ctrl restart >/dev/null 2>&1
            exit 0
        fi
    else
        if ! pidof xray >/dev/null 2>&1; then
            echo "$(date '+%Y-%m-%d %H:%M:%S') - [Watchdog] Xray core mati, menjalankan ulang..." >> /tmp/frdmxtunnel.log
            /usr/bin/frdmxtunnel_ctrl restart >/dev/null 2>&1
            exit 0
        fi
    fi

    # Cek koneksi internet menggunakan HTTP 204 dengan timeout 15 detik
    HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 8 --max-time 15 "$CHECK_URL")
    if [ "$HTTP_CODE" = "204" ] || [ "$HTTP_CODE" = "200" ]; then
        FAIL_COUNT=0
    else
        FAIL_COUNT=$((FAIL_COUNT + 1))
        echo "$(date '+%Y-%m-%d %H:%M:%S') - [Watchdog] Koneksi lambat/timeout ($FAIL_COUNT/4) [HTTP: ${HTTP_CODE:-000}]..." >> /tmp/frdmxtunnel.log

        # Butuh 4x gagal berturut-turut (~1.5 - 2 menit benar-benar mati) sebelum failover/restart
        if [ "$FAIL_COUNT" -ge 4 ]; then
            FAIL_COUNT=0
            TOTAL=$(uci show frdmxtunnel | grep -c "=profile$")
            if [ "$TOTAL" -gt 1 ]; then
                NEXT=$((CURR_IDX + 1))
                [ "$NEXT" -gt "$TOTAL" ] && NEXT=1
                echo "$(date '+%Y-%m-%d %H:%M:%S') - [Watchdog] Koneksi terputus! Auto-failover ke Profil #$NEXT..." >> /tmp/frdmxtunnel.log
                /usr/bin/frdmxtunnel_ctrl switch "$NEXT" >/dev/null 2>&1
            else
                echo "$(date '+%Y-%m-%d %H:%M:%S') - [Watchdog] Koneksi terputus! Auto-reconnect profil aktif..." >> /tmp/frdmxtunnel.log
                /usr/bin/frdmxtunnel_ctrl restart >/dev/null 2>&1
            fi
            exit 0
        fi
    fi
done
