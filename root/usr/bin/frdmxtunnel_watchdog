#!/bin/sh
sleep 35

FAIL_COUNT=0
RETRY_FILE="/tmp/frdmxtunnel_retry"

check_conn() {
    # Endpoint generate_204 ringan (0 byte body) agar hemat kuota & anti-timeout
    for URL in "http://cloudflare.com" "http://gstatic.com" "http://msftconnecttest.com"; do
        PROXY_ARG="-x socks5h://127.0.0.1:1080"; [ "$PROTO_NOW" = "ovpn" ] && PROXY_ARG=""; CODE=$(curl -s -I -o /dev/null -w "%{http_code}" $PROXY_ARG --connect-timeout 12 --max-time 20 "$URL" 2>/dev/null)
        if echo "$CODE" | grep -Eq "^(200|204|301|302)$"; then
            return 0
        fi
    done
    return 1
}

while true; do
    sleep 30

    [ -f "/tmp/frdmxtunnel_ctrl.lock" ] && continue
    ENABLED=$(uci -q get frdmxtunnel.main.enabled)
    [ "$ENABLED" != "1" ] && continue

    CURR_IDX=$(cat /tmp/frdmxtunnel_active_idx 2>/dev/null || echo 1)
    UCI_IDX=$((CURR_IDX - 1))
    PROTO_NOW=$(uci -q get frdmxtunnel.@profile[$UCI_IDX].proto)

    # 1. Cek jika proses inti benar-benar mati (crash)
    if [ "$PROTO_NOW" = "ovpn" ]; then
        if ! pidof openvpn >/dev/null 2>&1; then
            echo "$(date '+%Y-%m-%d %H:%M:%S') - [Watchdog] OpenVPN mati, menjalankan ulang..." >> /tmp/frdmxtunnel.log
            /usr/bin/frdmxtunnel_ctrl restart >/dev/null 2>&1
            exit 0
        fi
    else
        if ! pidof xray >/dev/null 2>&1; then
            echo "$(date '+%Y-%m-%d %H:%M:%S') - [Watchdog] Xray core mati, menjalankan ulang..." >> /tmp/frdmxtunnel.log
            /usr/bin/frdmxtunnel_ctrl restart >/dev/null 2>&1
            exit 0
        fi
    fi

    # 2. Cek responsivitas trafik melalui SOCKS5 lokal
    if check_conn; then
        if [ "$FAIL_COUNT" -gt 0 ] || [ -f "$RETRY_FILE" ]; then
            echo "$(date '+%Y-%m-%d %H:%M:%S') - [Watchdog] Koneksi pulih kembali (delay ping normal)." >> /tmp/frdmxtunnel.log
        fi
        FAIL_COUNT=0
        rm -f "$RETRY_FILE"
        continue
    fi

    FAIL_COUNT=$((FAIL_COUNT + 1))
    echo "$(date '+%Y-%m-%d %H:%M:%S') - [Watchdog] Ping tinggi / timeout ($FAIL_COUNT/5)..." >> /tmp/frdmxtunnel.log

    # 3. Tahap Pemulihan: 1x refresh profil saat ini dulu, baru pindah akun cadangan
    if [ "$FAIL_COUNT" -ge 5 ]; then
        FAIL_COUNT=0
        TOTAL=$(uci show frdmxtunnel | grep -c "=profile$")
        RETRIED_IDX=$(cat "$RETRY_FILE" 2>/dev/null)

        if [ "$RETRIED_IDX" != "$CURR_IDX" ]; then
            echo "$CURR_IDX" > "$RETRY_FILE"
            echo "$(date '+%Y-%m-%d %H:%M:%S') - [Watchdog] Refresh koneksi Profil #$CURR_IDX terlebih dahulu..." >> /tmp/frdmxtunnel.log
            /usr/bin/frdmxtunnel_ctrl restart >/dev/null 2>&1
            exit 0
        elif [ "$TOTAL" -gt 1 ]; then
            rm -f "$RETRY_FILE"
            NEXT=$((CURR_IDX + 1))
            [ "$NEXT" -gt "$TOTAL" ] && NEXT=1
            echo "$(date '+%Y-%m-%d %H:%M:%S') - [Watchdog] Profil #$CURR_IDX tetap gagal setelah refresh, auto-failover ke Profil #$NEXT..." >> /tmp/frdmxtunnel.log
            /usr/bin/frdmxtunnel_ctrl switch "$NEXT" >/dev/null 2>&1
            exit 0
        else
            rm -f "$RETRY_FILE"
            echo "$(date '+%Y-%m-%d %H:%M:%S') - [Watchdog] Auto-reconnect profil aktif..." >> /tmp/frdmxtunnel.log
            /usr/bin/frdmxtunnel_ctrl restart >/dev/null 2>&1
            exit 0
        fi
    fi
done
