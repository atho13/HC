#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

apply_kernel_tuning() {
    local target_qdisc="fq"
    local target_cc="bbr"

    local current_cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
    if [ "$current_cc" != "$target_cc" ]; then
        sysctl -w net.core.default_qdisc=$target_qdisc >/dev/null 2>&1
        sysctl -w net.ipv4.tcp_congestion_control=$target_cc >/dev/null 2>&1
        logger -t "httpcustom" "Kernel Tuning: TCP BBR enabled."
    fi

    if command -v iptables >/dev/null 2>&1; then
        iptables -t mangle -C FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || \
        iptables -t mangle -A FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null
    fi
}

cleanup_processes() {
    for pid in $(pgrep -f "httpcustom_payload.py"); do kill -9 "$pid" 2>/dev/null; done
    for pid in $(pgrep -f "xray_custom.json"); do kill -9 "$pid" 2>/dev/null; done
    for pid in $(pgrep -f "ProxyCommand=nc 127.0.0.1 8989"); do kill -9 "$pid" 2>/dev/null; done
}

start_service() {
    config_load httpcustom
    local enabled
    config_get_bool enabled main enabled 0
    [ "$enabled" -eq 1 ] || return 0

    cleanup_processes
    apply_kernel_tuning

    procd_open_instance
    procd_set_param command /usr/bin/httpcustom_core
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 3600 5 5
    procd_close_instance

    logger -t "httpcustom" "Service started. MTU/MSS & Kernel optimizations applied."
}

stop_service() {
    cleanup_processes
    if command -v iptables >/dev/null 2>&1; then
        iptables -t mangle -D FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null
    fi
    logger -t "httpcustom" "Service stopped and cleaned up."
}

service_triggers() {
    procd_add_reload_trigger "httpcustom"
}
