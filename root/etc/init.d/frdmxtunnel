#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/frdmxtunnel_core
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    killall -9 frdmxtunnel_watchdog xray ssh sshpass stunnel openvpn python3 qssh zivpn 2>/dev/null
    nft delete table inet frdmxtunnel 2>/dev/null
    iptables -t nat -D PREROUTING -i br-lan -j FRDMXTUNNEL 2>/dev/null
    iptables -t nat -D OUTPUT -j FRDMXTUNNEL_OUT 2>/dev/null
    iptables -t nat -F FRDMXTUNNEL 2>/dev/null
    iptables -t nat -X FRDMXTUNNEL 2>/dev/null
    iptables -t nat -F FRDMXTUNNEL_OUT 2>/dev/null
    iptables -t nat -X FRDMXTUNNEL_OUT 2>/dev/null
    rm -f /tmp/frdmxtunnel_pubip
}

service_triggers() {
    procd_add_reload_trigger "frdmxtunnel"
}
